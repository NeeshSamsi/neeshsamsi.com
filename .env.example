# Discord webhook URL for the ContactWidget server action.
# Create one via your Discord server: Server Settings → Integrations → Webhooks → New Webhook.
# Must start with https://discord.com/api/webhooks/ — validated at build time by src/lib/env.ts.
DISCORD_WEBHOOK_URL=

# Optional. Shared secret for the Prismic webhook that calls /api/revalidate
# (Prismic: Settings → Webhooks → Secret). When set, requests without the
# matching secret get a 401. Leave empty to accept any POST.
PRISMIC_WEBHOOK_SECRET=

# Optional, local only (not needed on Vercel). Write API token for scripts
# that stage content changes through Prismic's Migration API
# (Prismic: Settings → API & Security → Write APIs → Generate a token).
PRISMIC_WRITE_TOKEN=

# Optional, local only (not needed on Vercel). Mux access token for the script
# that uploads clips to Mux and reads back their playback IDs. Playback on the
# site uses public playback IDs, so the site itself needs no Mux secret.
# Mux dashboard → Settings → Access Tokens → Generate new token:
#   Environment: Production; permissions: Mux Video, Read and Write.
# The secret key is shown only once. The Mux "environment key" is for Mux Data
# analytics and is not needed here.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
